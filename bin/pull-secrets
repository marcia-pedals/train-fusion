#!/usr/bin/env python3
"""Write every train-fusion secret in Secret Manager (label app=train-fusion; see
infra/secrets.tf) into .env.local as KEY="value", keeping any other lines."""
import re
import subprocess
from pathlib import Path

PROJECT = "train-fusion"
ENV = Path(__file__).resolve().parents[1] / ".env.local"


def gcloud(*args: str) -> str:
    return subprocess.run(["gcloud", *args, f"--project={PROJECT}"], check=True,
                          capture_output=True, text=True).stdout


names = gcloud("secrets", "list", "--filter=labels.app=train-fusion", "--format=value(name)").split()
values = {n: gcloud("secrets", "versions", "access", "latest", f"--secret={n}") for n in names}
lines = ENV.read_text().splitlines() if ENV.exists() else []
kept = [l for l in lines if not re.match(rf"\s*({'|'.join(map(re.escape, values))})\s*=", l)] if values else lines
ENV.write_text("\n".join(kept + [f'{k}="{v}"' for k, v in sorted(values.items())]) + "\n")
ENV.chmod(0o600)
print(f"wrote {sorted(values)} to {ENV}")
